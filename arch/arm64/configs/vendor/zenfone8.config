# Asus sake platform
CONFIG_MACH_ASUS_SAKE=y

# Asus sake DTS overlay
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Compile
CONFIG_CC_WERROR=y

# Goodix fingerprint
CONFIG_GOODIX_FINGERPRINT_2ND=m

# Input haptic driver
CONFIG_INPUT_QCOM_HV_HAPTICS=n
CONFIG_AW8697_HAPTIC=m

# Input touchscreen
CONFIG_TOUCHSCREEN_FTS_ZF=m
# CONFIG_TOUCHSCREEN_ST is not set
# CONFIG_TOUCHSCREEN_FTS is not set

# Input SX932X
CONFIG_INPUT_SX932X_SAKE=m

# Input Device Drivers
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y

# MMC/SD/SDIO Host Controller Drivers
CONFIG_LEDS_CLASS_MULTICOLOR=y

# Networking
CONFIG_NET_ACT_BPF=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_USB_NET_AQC111=y
CONFIG_USB_NET_CDC_EEM=y
CONFIG_USB_RTL8150=y

# Nfc
CONFIG_NFC_QTI_I2C=n

# Pseudo filesystems
CONFIG_EROFS_FS_PCPU_KTHREAD=y
CONFIG_EROFS_FS_PCPU_KTHREAD_HIPRI=y

# Serial drivers
CONFIG_SERIAL_8250_RUNTIME_UARTS=0
CONFIG_SERIAL_8250_DW=y

# Special HID drivers
CONFIG_HID_BETOP_FF=y

# Synaptics
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX=y

# VINTF Level 6
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_XCBC=y
CONFIG_USERFAULTFD=y
CONFIG_XFRM_MIGRATE=y

# Wireguard
CONFIG_ARM64_CRYPTO=n
CONFIG_WIREGUARD=y
